# Clerk Configuration
# IMPORTANT: Test keys (pk_test_*) only work in localhost development!
# For production, replace with Live keys (pk_live_*/sk_live_*) from Clerk Dashboard.
# Test keys on a live domain cause "dev-browser-missing" handshake redirects.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk Satellite Mode (required when using custom FAPI domain)
# If you configure a custom Clerk FAPI domain (e.g., clerk.yourdomain.com), uncomment:
# CLERK_IS_SATELLITE=true
# CLERK_DOMAIN=clerk.yourdomain.com
# IMPORTANT: The custom FAPI domain must use "DNS only" (grey cloud) in Cloudflare,
# NOT "Proxied" (orange cloud). Otherwise Cloudflare routes requests to your origin
# server instead of Clerk's servers, causing 404/CORS errors.

# Prisma & Database Configuration
# Update the DATABASE_URL with your database credentials
DATABASE_URL=postgresql://username:password@localhost:5432/your_database_name

# Uploadthing Configuration
UPLOADTHING_TOKEN='your_uploadthing_token_here'

# Mux Configuration
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Stripe Configuration
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Server Port (default: 3000)
# Change this to run on a different port
PORT=3000

# App URL - Must match your server address (no trailing slash)
# IMPORTANT: Must use https:// when behind Cloudflare/Nginx reverse proxy
# Wrong: NEXT_PUBLIC_APP_URL=http://your-domain.com  (causes redirect loops)
# Right: NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TEACHER_ID=your_teacher_id